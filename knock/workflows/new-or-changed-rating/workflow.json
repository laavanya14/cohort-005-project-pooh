{
  "key": "new-or-changed-rating",
  "name": "New or changed rating",
  "description": "Tells an instructor a student rated their course, or changed their rating. Inbox only, batched into one item per course per hour.",
  "categories": [
    "activity"
  ],
  "steps": [
    {
      "ref": "batch_1",
      "type": "batch",
      "settings": {
        "batch_key": "data.courseId",
        "batch_window": {
          "unit": "hours",
          "value": 1
        },
        "batch_window_type": "fixed",
        "batch_order": "asc"
      }
    },
    {
      "ref": "in_app_feed_1",
      "type": "channel",
      "channel_key": "in-app",
      "template": {
        "action_url": "{{ data.path }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      }
    }
  ]
}
